# ------------------------------------------------------------------------
# Self-hosting in production: compose.yaml (repository root) builds and starts
# postgres + redis + storage (RustFS) + web + worker + migrations. Three commands:
#   git clone … && cd open-helpdesk
#   cp .env.example .env   # fill in BETTER_AUTH_SECRET and ENCRYPTION_KEY
#   docker compose up -d   # http://localhost:3000
# The internal hosts (postgres, redis, storage) are pinned by compose.yaml and
# take precedence over the development values below.
# ------------------------------------------------------------------------

# Acme demo workspace, installed on the first start of the production compose
# stack (login marie.dupont@acme.example / demo-openhelpdesk).
# Switch to false once your own agents exist.
SEED_DEMO=true

# Your own first workspace, without the demo: set SEED_DEMO=false, set
# DEFAULT_TENANT_SLUG below to the workspace's short name, and fill these in.
# Created on the first start of the compose stack when OWNER_EMAIL is set
# (pnpm workspace:setup by hand). Read ONCE: later starts change nothing, so
# edit the workspace in Settings afterwards, and remove OWNER_PASSWORD from
# this file once you have signed in.
# WORKSPACE_NAME="My Company Support"
# One of: bg cs da de el en es et fi fr ga hr hu it lt lv mt nb nl pl pt ro sk sl sv
# WORKSPACE_LOCALE=en
# An IANA time zone; business hours and SLA targets count in it.
# WORKSPACE_TIMEZONE=Europe/Paris
# Example business hours, teams, SLA policies, macros, rules and fields.
# WORKSPACE_STARTER_SETTINGS=true
# The first owner. Everyone else is invited from Settings → Team.
# OWNER_NAME="Your Name"
# OWNER_EMAIL=you@example.com
# 8 to 128 characters.
# OWNER_PASSWORD=

# Runtime edition: self-hosted (default) or cloud. Self-hosted unlocks the
# whole AGPL core, with no seat quota; the /ee features stay locked. With
# "cloud", entitlements are resolved by an external control plane instead.
# OPENHELPDESK_EDITION=self-hosted

# Database (docker/docker-compose.yml provides these defaults; host ports are
# shifted — 5439/6380 — so the stack can coexist with other local projects)
DATABASE_URL=postgres://openhelpdesk:openhelpdesk@localhost:5439/openhelpdesk

# Redis — BullMQ queues (SLA, email ingestion, automations, provisioning)
REDIS_URL=redis://localhost:6380

# Multi-tenant resolution: {slug}.$BASE_DOMAIN → tenant "slug".
# In development, acme.localhost:3000 works in modern browsers.
BASE_DOMAIN=localhost:3000
# Single-tenant self-hosting: the tenant served on the bare domain. Without the
# demo, it is also the short name your first workspace is created with.
DEFAULT_TENANT_SLUG=acme

# Auth (Better Auth)
BETTER_AUTH_SECRET=change-me
# Control-plane deployments: session cookie shared between www. and the tenant
# subdomains.
# AUTH_COOKIE_DOMAIN=
# Sign-in is refused until the address is confirmed. Implies the mail below.
# REQUIRE_EMAIL_VERIFICATION=false
# Send the confirmation mail WITHOUT gating sign-in on it: the account works
# right away and confirms its address afterwards. Use one or the other.
# SEND_EMAIL_VERIFICATION=false
# Named in that mail, and enforced by whoever runs the deadline (the control
# plane suspends what is still unconfirmed). Unset: the mail promises nothing.
# EMAIL_VERIFICATION_DEADLINE_DAYS=7

# Encryption of secrets at rest (SMTP passwords, API keys, SSO secrets).
# 32 random bytes: openssl rand -base64 32
ENCRYPTION_KEY=change-me-32-bytes-minimum-please

# Email — ingestion (webhook /api/ingress/email)
MAIL_INGRESS_SECRET=dev-ingress-secret

# Domain of the provided email addresses: support@{slug}.MANAGED_MAIL_DOMAIN.
# Falls back to BASE_DOMAIN without its port.
# MANAGED_MAIL_DOMAIN=

# Control-plane deployments: the "workspace not found" 404 points here so a
# visitor can create one.
# SIGNUP_URL=

# Control-plane deployments: private gateway of the control plane. The product
# asks it for a session URL and redirects the user there — it never holds any
# third-party credentials of its own.
# CLOUD_GATEWAY_URL=
# CLOUD_GATEWAY_SECRET=

# Email — sending. Each workspace picks its provider in
# Settings → Channels → Email (stored encrypted in the database). The variables
# below only act as an instance-wide FALLBACK when a workspace has configured
# nothing: single-tenant self-hosting, or the instance default address.
MAIL_FROM=support@open-helpdesk.local
# SMTP (also covers Brevo, Mailjet, Mailgun, SES, Postmark… through their relay)
# SMTP_HOST=localhost
# SMTP_PORT=1026
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# Native APIs (pick one; the first one filled in wins)
# RESEND_API_KEY=
# BREVO_API_KEY=
# MAILJET_API_KEY=
# MAILJET_API_SECRET=

# S3-compatible storage (RustFS locally — any S3 server works)
S3_ENDPOINT=http://localhost:9010
S3_ACCESS_KEY_ID=openhelpdesk
S3_SECRET_ACCESS_KEY=openhelpdesk
S3_BUCKET=attachments

# Mobile app (MO-xx) — the phone side of the workspace.
#
# The URL scheme the app is registered for. It is where a browser sign-in hands
# the session back (SSO for an agent, a magic link for a customer), and it is
# NEVER taken from a request: an endpoint that mints a credential and sends it
# wherever it is told is an account takeover waiting for a phishing link.
# MOBILE_APP_SCHEME=openhelpdesk
#
# Push notifications. Nothing configured means notifications are LOGGED instead
# of sent (provider "console"), so a local install exercises the whole chain
# without an Apple key. PUSH_PROVIDER=console forces that even where credentials
# exist — a staging instance sharing a database has nobody to wake.
# PUSH_PROVIDER=console
#
# APNs (iOS): the .p8 key downloaded from Apple, its id, your team, the bundle
# id of the build. APNS_HOST is the sandbox for a development build —
# https://api.sandbox.push.apple.com — and tokens are not interchangeable
# between the two.
# APNS_TEAM_ID=
# APNS_KEY_ID=
# APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n…\n-----END PRIVATE KEY-----"
# APNS_BUNDLE_ID=com.example.helpdesk
# APNS_HOST=https://api.push.apple.com
#
# FCM (Android): a service account of the Firebase project, with the
# "Firebase Cloud Messaging API" enabled.
# FCM_PROJECT_ID=
# FCM_CLIENT_EMAIL=
# FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n…\n-----END PRIVATE KEY-----"

# Assistant IA (édition hébergée uniquement). Sans AI_API_BASE ni AI_MODEL,
# l'assistant reste éteint et chaque écran le dit : instanceProvider() rend
# null. Un endpoint compatible OpenAI suffit — Scaleway pour l'instance
# hébergée, un Ollama ou un vLLM pour qui apporte son modèle.
AI_API_BASE=https://api.scaleway.ai/v1
AI_MODEL=gemma-4-26b-a4b-it
AI_EMBED_MODEL=qwen3-embedding-8b
AI_PROVIDER_LABEL="Scaleway (fr-par)"
AI_API_KEY=
